<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="720.0" prefWidth="1150.0"
           style="-fx-background-color: #0b1120;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="lk.fraudshield.client.ui.LoginController">

    <VBox alignment="CENTER" spacing="18.0" maxWidth="420.0" maxHeight="540.0"
          style="-fx-background-color: #161f33; -fx-padding: 35 40; -fx-background-radius: 16; -fx-border-color: #26334d; -fx-border-radius: 16;">

        <VBox alignment="CENTER" spacing="6.0">
            <Label text="FraudShield" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
            <Label text="Secure Multi-Agent Banking Client" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
        </VBox>

        <HBox alignment="CENTER" maxWidth="Infinity"
              style="-fx-background-color: #064e3b; -fx-padding: 7 15; -fx-background-radius: 20; -fx-border-color: #10b981; -fx-border-radius: 20;">
            <Label text="● TLS Sockets Ready" style="-fx-text-fill: #34d399; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        </HBox>

        <VBox spacing="6.0" maxWidth="Infinity">
            <Label text="SERVER GATEWAY (TCP)" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <HBox spacing="10.0">
                <TextField fx:id="hostField" text="127.0.0.1" HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #0284c7; -fx-border-radius: 6;"/>
                <TextField fx:id="portField" text="5000" prefWidth="80.0"
                           style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #334155; -fx-border-radius: 6;"/>
            </HBox>
        </VBox>

        <VBox spacing="6.0" maxWidth="Infinity">
            <Label text="USERNAME" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <TextField fx:id="usernameField" promptText="Enter client username"
                       style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #334155; -fx-border-radius: 6;"/>
        </VBox>

        <VBox spacing="6.0" maxWidth="Infinity">
            <Label text="PASSWORD" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField" promptText="••••••••"
                           style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #334155; -fx-border-radius: 6;"/>
        </VBox>

        <Label fx:id="statusLabel" text="" wrapText="true" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>

        <Button text="Connect &amp; Authenticate" onAction="#handleLogin" maxWidth="Infinity"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <HBox alignment="CENTER" spacing="6.0">
            <Label text="New customer?" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <Hyperlink text="Create Account (Register)" onAction="#handleOpenRegister"
                       style="-fx-text-fill: #38bdf8; -fx-font-size: 12px; -fx-font-weight: bold; -fx-border-color: transparent;"/>
        </HBox>

    </VBox>
</StackPane>