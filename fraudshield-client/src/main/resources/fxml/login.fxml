<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane stylesheets="@../styles/styles.css" styleClass="root-container"
           prefHeight="600.0" prefWidth="800.0"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="lk.fraudshield.client.ui.LoginController">

    <!-- Card Container -->
    <VBox alignment="CENTER" maxWidth="420.0" spacing="20.0" styleClass="login-card">
        <padding>
            <Insets bottom="36.0" left="36.0" right="36.0" top="36.0" />
        </padding>

        <!-- Brand Header -->
        <VBox alignment="CENTER" spacing="6.0">
            <Label styleClass="brand-title" text="FraudShield" />
            <Label styleClass="brand-subtitle" text="Secure Multi-Agent Banking Client" />

            <!-- Connection Indicator -->
            <HBox alignment="CENTER" spacing="6.0" styleClass="status-badge">
                <children>
                    <Circle fill="#22c55e" radius="4.0" />
                    <Label styleClass="status-text" text="TLS Sockets Ready" />
                </children>
                <VBox.margin>
                    <Insets top="4.0" />
                </VBox.margin>
            </HBox>
        </VBox>

        <!-- Server IP / Port Configuration -->
        <VBox spacing="6.0">
            <Label styleClass="input-label" text="SERVER GATEWAY (TCP)" />
            <HBox spacing="8.0">
                <TextField fx:id="serverIpField" promptText="127.0.0.1" text="127.0.0.1"
                           HBox.hgrow="ALWAYS" styleClass="text-input-field" prefHeight="42.0"/>
                <TextField fx:id="serverPortField" promptText="5000" text="5000"
                           prefWidth="90.0" styleClass="text-input-field" prefHeight="42.0"/>
            </HBox>
        </VBox>

        <!-- Credentials -->
        <VBox spacing="14.0">
            <VBox spacing="6.0">
                <Label styleClass="input-label" text="USERNAME" />
                <TextField fx:id="usernameField" promptText="Enter client username"
                           styleClass="text-input-field" prefHeight="42.0"/>
            </VBox>

            <VBox spacing="6.0">
                <Label styleClass="input-label" text="PASSWORD" />
                <PasswordField fx:id="passwordField" promptText="••••••••"
                               styleClass="text-input-field" prefHeight="42.0"/>
            </VBox>
        </VBox>

        <!-- Login Button -->
        <Button fx:id="loginButton" maxWidth="Infinity" prefHeight="44.0"
                styleClass="btn-primary" text="Connect &amp; Authenticate" />

        <!-- Error / Status Feedback Label -->
        <Label fx:id="statusLabel" textFill="#f87171" wrapText="true" visible="false" />
    </VBox>
</StackPane>