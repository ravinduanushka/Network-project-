<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="330.0" prefWidth="430.0" spacing="16.0" styleClass="login-card" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.fraudshield.client.ui.OtpDialogController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <Label styleClass="brand-title" style="-fx-font-size: 20px; -fx-text-fill: #f59e0b;" text="Step-Up Authentication" />
    <Label styleClass="brand-subtitle" style="-fx-font-size: 12px;" text="High-value transfer or elevated transaction risk detected." textAlignment="CENTER" wrapText="true" />
    <Label fx:id="timerLabel" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 13px;" text="Code expires in: 01:59" />

    <TextField fx:id="otpInputField" alignment="CENTER" maxWidth="220.0" promptText="Enter 6-digit OTP" styleClass="text-input-field" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    <Label fx:id="errorLabel" style="-fx-text-fill: #f87171; -fx-font-size: 12px;" visible="false" />

    <HBox alignment="CENTER" spacing="12.0">
        <Button onAction="#handleCancel" prefHeight="38.0" prefWidth="100.0" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-background-radius: 6px; -fx-cursor: hand;" text="Cancel" />
        <Button onAction="#handleVerify" prefHeight="38.0" prefWidth="150.0" styleClass="btn-primary" text="Verify &amp; Confirm" />
    </HBox>
</VBox>