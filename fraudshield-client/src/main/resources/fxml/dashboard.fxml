<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1150.0"
            style="-fx-background-color: #0b1120;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.fraudshield.client.ui.DashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #0f172a; -fx-padding: 15 25; -fx-border-color: #1e293b; -fx-border-width: 0 0 1 0;">
            <Label text="FraudShield Banking" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #064e3b; -fx-padding: 6 14; -fx-background-radius: 20; -fx-border-color: #10b981; -fx-border-radius: 20;">
                <Label text="● Connected: Port 5000" style="-fx-text-fill: #34d399; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </HBox>
            <Label text="User: ACC-88910" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px;"/>
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #334155; -fx-text-fill: white; -fx-padding: 6 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #0b1120;">
            <tabs>

                <Tab text="Account Overview">
                    <VBox spacing="20.0" style="-fx-padding: 25; -fx-background-color: #0b1120;">
                        <HBox spacing="20.0">
                            <VBox spacing="8.0" prefWidth="300.0" style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12;">
                                <Label text="AVAILABLE BALANCE" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Label fx:id="balanceLabel" text="LKR 250,000.00" style="-fx-text-fill: #38bdf8; -fx-font-size: 26px; -fx-font-weight: bold;"/>
                                <Label fx:id="accountNumberLabel" text="Account No: 1000-2938-4412" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                            </VBox>

                            <VBox spacing="8.0" prefWidth="300.0" style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12;">
                                <Label text="FRAUD SHIELD ENGINE" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Label fx:id="engineStatusLabel" text="Active &amp; Protected" style="-fx-text-fill: #4ade80; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                                <Label text="UDP Sentinel listening on Port 6000" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                            </VBox>
                        </HBox>

                        <Label text="RECENT TRANSACTIONS" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                        <TableView fx:id="transactionsTable" VBox.vgrow="ALWAYS" style="-fx-background-color: #1e293b; -fx-border-color: #334155;"/>
                    </VBox>
                </Tab>

                <Tab text="Fund Transfer">
                    <VBox spacing="18.0" style="-fx-padding: 25; -fx-background-color: #0b1120;">
                        <Label text="Initiate Secure Wire Transfer" style="-fx-text-fill: #f8fafc; -fx-font-size: 18px; -fx-font-weight: bold;"/>

                        <VBox spacing="14.0" maxWidth="460.0" style="-fx-background-color: #1e293b; -fx-padding: 22; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12;">
                            <VBox spacing="6.0">
                                <Label text="RECIPIENT ACCOUNT NUMBER" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <TextField fx:id="recipientAccountField" promptText="e.g., 1000-8842-9910"
                                           style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #334155; -fx-border-radius: 6;"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="TRANSFER AMOUNT (LKR)" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <TextField fx:id="transferAmountField" promptText="0.00"
                                           style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #334155; -fx-border-radius: 6;"/>
                            </VBox>

                            <VBox spacing="6.0">
                                <Label text="REFERENCE NOTE" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <TextField fx:id="referenceNoteField" promptText="Optional description"
                                           style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #334155; -fx-border-radius: 6;"/>
                            </VBox>

                            <Label fx:id="transferStatusLabel" text="" wrapText="true" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>

                            <Button text="Verify &amp; Transfer Funds" onAction="#handleFundTransfer" maxWidth="Infinity"
                                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        </VBox>
                    </VBox>
                </Tab>

                <Tab text="Fraud Alerts (UDP Live)">
                    <VBox spacing="16.0" style="-fx-padding: 25; -fx-background-color: #0b1120;">
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <VBox spacing="4.0">
                                <Label text="Real-Time UDP Threat Monitor (Port 6000)" style="-fx-text-fill: #f8fafc; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                                <Label text="Live anomaly packets broadcasted from FraudShield Sentinel Engine" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Simulate Test Alert" onAction="#handleSimulateAlert"
                                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        </HBox>

                        <ListView fx:id="fraudAlertsListView" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: #1e293b; -fx-control-inner-background: #1e293b; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                    </VBox>
                </Tab>

            </tabs>
        </TabPane>
    </center>
</BorderPane>