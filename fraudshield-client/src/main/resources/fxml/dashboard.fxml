<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="750.0" prefWidth="1180.0"
            style="-fx-background-color: #f8fafc;"
            stylesheets="@../styles/styles.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.fraudshield.client.ui.DashboardController">

    <!-- ================= TOP HEADER BAR (VIBRANT ROYAL BLUE GRADIENT - IMAGE 2) ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0"
              style="-fx-background-color: linear-gradient(to right, #1d4ed8 0%, #2563eb 55%, #3b82f6 100%); -fx-padding: 14 35; -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.22), 16, 0, 0, 4);">
            
            <!-- Brand Logo -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <StackPane prefWidth="30.0" prefHeight="30.0" style="-fx-background-color: rgba(255, 255, 255, 0.22); -fx-background-radius: 8;">
                    <SVGPath content="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm-1 14.5l-3.5-3.5 1.41-1.41L11 13.67l5.09-5.09 1.41 1.41L11 16.5z"
                             fill="WHITE"/>
                </StackPane>
                <HBox alignment="BASELINE_LEFT" spacing="5.0">
                    <Label text="FraudShield" style="-fx-text-fill: white; -fx-font-size: 19px; -fx-font-weight: 800; -fx-font-family: 'Poppins', 'Urbanist', 'Plus Jakarta Sans', sans-serif;"/>
                    <Label text="Banking" style="-fx-text-fill: rgba(255, 255, 255, 0.82); -fx-font-size: 16px; -fx-font-weight: 600;"/>
                </HBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Right Status & User Navigation Pill Items -->
            <HBox alignment="CENTER" spacing="16.0">
                <!-- Connected Port Pill -->
                <HBox alignment="CENTER" spacing="7.0"
                      style="-fx-background-color: rgba(255, 255, 255, 0.16); -fx-padding: 6 15; -fx-background-radius: 20;">
                    <Circle radius="4.0" fill="#4ade80"/>
                    <Label text="Connected: Port 5000" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Modern User Profile Pill: Avatar Circle + User Name + Account Number -->
                <HBox alignment="CENTER" spacing="10.0"
                      style="-fx-background-color: rgba(255, 255, 255, 0.18); -fx-padding: 4 14 4 6; -fx-background-radius: 22; -fx-border-color: rgba(255, 255, 255, 0.3); -fx-border-radius: 22; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 6, 0, 0, 2);">
                    <StackPane prefWidth="32.0" prefHeight="32.0"
                               style="-fx-background-color: #0f172a; -fx-background-radius: 16; -fx-border-color: rgba(255, 255, 255, 0.4); -fx-border-radius: 16;">
                        <Label fx:id="userAvatarLabel" text="AN" style="-fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: 800;"/>
                    </StackPane>
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label fx:id="topUserNameLabel" text="Anushka"
                               style="-fx-text-fill: white; -fx-font-size: 13.5px; -fx-font-weight: 800; -fx-font-family: 'Poppins', 'Urbanist', 'Segoe UI', sans-serif;"/>
                        <Label text="·" style="-fx-text-fill: rgba(255, 255, 255, 0.6); -fx-font-size: 13px; -fx-font-weight: bold;"/>
                        <Label fx:id="topAccountLabel" text="ACC-88910"
                               style="-fx-text-fill: rgba(255, 255, 255, 0.88); -fx-font-size: 12px; -fx-font-weight: 600;"/>
                    </HBox>
                </HBox>

                <!-- Logout Button -->
                <Button text="Logout" onAction="#handleLogout"
                        style="-fx-background-color: rgba(255, 255, 255, 0.12); -fx-border-color: rgba(255, 255, 255, 0.35); -fx-border-radius: 18; -fx-background-radius: 18; -fx-text-fill: white; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-padding: 6 18; -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ================= MAIN TAB CONTENT (CLEAN WHITE / SLATE MODERN - IMAGE 2) ================= -->
    <center>
        <TabPane fx:id="dashboardTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="dashboard-tab-pane">
            <tabs>

                <!-- ================= TAB 1: ACCOUNT OVERVIEW ================= -->
                <Tab fx:id="overviewTab" text="Account Overview">
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">
                        <VBox spacing="24.0" style="-fx-padding: 24 35 35 35; -fx-background-color: #f8fafc;">

                            <!-- User Greeting Section & Back Button (Under header right corner) -->
                            <HBox alignment="CENTER_LEFT">
                                <VBox spacing="2.0">
                                    <Label text="Welcome back" style="-fx-text-fill: #64748b; -fx-font-size: 12.5px; -fx-font-weight: 500;"/>
                                    <Label fx:id="welcomeUserLabel" text="Anushka"
                                           style="-fx-text-fill: #0f172a; -fx-font-size: 28px; -fx-font-weight: 800; -fx-font-family: 'Poppins', 'Urbanist', 'Plus Jakarta Sans', sans-serif;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="← Back to Home" onAction="#handleBackToHome"
                                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 20; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-cursor: hand;"/>
                            </HBox>

                            <!-- Top 3 Metric & Quick Action Cards -->
                            <HBox spacing="20.0">

                                <!-- Card 1: Available Balance (Vibrant Blue Card) -->
                                <VBox prefWidth="350.0" HBox.hgrow="ALWAYS" spacing="10.0"
                                      style="-fx-background-color: linear-gradient(to bottom right, #2563eb, #1d4ed8); -fx-padding: 22 24; -fx-background-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(37, 99, 235, 0.35), 20, 0, 0, 8);">
                                    <Label text="AVAILABLE BALANCE" style="-fx-text-fill: #bfdbfe; -fx-font-size: 11px; -fx-font-weight: 800; -fx-letter-spacing: 0.5px;"/>
                                    <Label fx:id="balanceLabel" text="LKR 250,000.00"
                                           style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: 800; -fx-font-family: 'Poppins', 'Urbanist', 'Plus Jakarta Sans', sans-serif;"/>
                                    <Label fx:id="accountNumberLabel" text="ACC-ANUSHKA12 · anushka12"
                                           style="-fx-text-fill: #dbeafe; -fx-font-size: 12px; -fx-font-weight: 500;"/>
                                </VBox>

                                <!-- Card 2: Fraud Shield Engine Status -->
                                <VBox prefWidth="350.0" HBox.hgrow="ALWAYS" spacing="10.0"
                                      style="-fx-background-color: #ffffff; -fx-padding: 22 24; -fx-background-radius: 18; -fx-border-color: #e2e8f0; -fx-border-width: 1.2; -fx-border-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.04), 14, 0, 0, 4);">
                                    <Label text="FRAUD SHIELD ENGINE" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: 800; -fx-letter-spacing: 0.5px;"/>
                                    <Label fx:id="engineStatusLabel" text="● Server Offline"
                                           style="-fx-text-fill: #ef4444; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                                    <Label text="UDP Sentinel · Port 6000" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                                </VBox>

                                <!-- Card 3: Quick Actions (Send money / View alerts) -->
                                <VBox prefWidth="350.0" HBox.hgrow="ALWAYS" spacing="10.0"
                                      style="-fx-background-color: #ffffff; -fx-padding: 22 24; -fx-background-radius: 18; -fx-border-color: #e2e8f0; -fx-border-width: 1.2; -fx-border-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.04), 14, 0, 0, 4);">
                                    <Label text="QUICK ACTIONS" style="-fx-text-fill: #64748b; -fx-font-size: 11px; -fx-font-weight: 800; -fx-letter-spacing: 0.5px;"/>
                                    <Label text="Move money or check recent alerts." style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                                    <HBox spacing="10.0" style="-fx-padding: 4 0 0 0;">
                                        <Button text="Send money" onAction="#handleGoToTransfer"
                                                style="-fx-background-color: #fc831bf2; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-padding: 8 20; -fx-background-radius: 18; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(252, 131, 27, 0.42), 8, 0, 0, 2);"/>
                                        <Button text="View alerts" onAction="#handleGoToAlerts"
                                                style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-font-weight: bold; -fx-font-size: 12.5px; -fx-padding: 8 20; -fx-background-radius: 18; -fx-cursor: hand;"/>
                                    </HBox>
                                </VBox>

                            </HBox>

                            <!-- Recent Transactions Header -->
                            <HBox alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0;">
                                <Label text="Recent transactions"
                                       style="-fx-font-size: 18px; -fx-font-weight: 800; -fx-text-fill: #0f172a; -fx-font-family: 'Poppins', 'Urbanist', 'Plus Jakarta Sans', sans-serif;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="txCountLabel" text="4 transactions" style="-fx-font-size: 12.5px; -fx-text-fill: #64748b;"/>
                            </HBox>

                            <!-- Modern Styled TableView with Alternating Striping & Security Pills -->
                            <TableView fx:id="transactionsTable" prefHeight="330.0" minHeight="290.0" styleClass="modern-table">
                                <columns>
                                    <TableColumn fx:id="colTimestamp" text="DATE &amp; TIME" prefWidth="240.0"/>
                                    <TableColumn fx:id="colRecipient" text="RECIPIENT ACCOUNT" prefWidth="300.0"/>
                                    <TableColumn fx:id="colAmount" text="AMOUNT (LKR)" prefWidth="230.0"/>
                                    <TableColumn fx:id="colStatus" text="SECURITY STATUS" prefWidth="280.0"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>

                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- ================= TAB 2: FUND TRANSFER (IMAGE 1) ================= -->
                <Tab fx:id="transferTab" text="Fund Transfer">
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">
                        <VBox alignment="TOP_CENTER" spacing="24.0" style="-fx-padding: 24 35 35 35; -fx-background-color: #f8fafc;">
                            
                            <!-- Header Title & Back Button (Under header right corner) -->
                            <HBox alignment="CENTER_LEFT" maxWidth="1010.0">
                                <Label text="Send money"
                                       style="-fx-text-fill: #0f172a; -fx-font-size: 28px; -fx-font-weight: 800; -fx-font-family: 'Poppins', 'Urbanist', 'Plus Jakarta Sans', sans-serif;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="← Back to Home" onAction="#handleBackToHome"
                                        style="-fx-background-color: #ffffff; -fx-text-fill: #334155; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 20; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-cursor: hand;"/>
                            </HBox>

                            <!-- Two Columns: Left = Quick transfer, Right = HOW YOUR TRANSFER IS PROTECTED (CENTERED) -->
                            <HBox spacing="25.0" alignment="TOP_CENTER" maxWidth="1010.0">

                                <!-- Left Card: Quick transfer -->
                                <VBox prefWidth="420.0" minWidth="380.0" spacing="16.0"
                                      style="-fx-background-color: #ffffff; -fx-padding: 26 28; -fx-background-radius: 18; -fx-border-color: #e2e8f0; -fx-border-width: 1.2; -fx-border-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.05), 18, 0, 0, 4);">
                                    
                                    <Label text="Quick transfer"
                                           style="-fx-text-fill: #0f172a; -fx-font-size: 18px; -fx-font-weight: 800; -fx-font-family: 'Poppins', 'Urbanist', 'Plus Jakarta Sans', sans-serif;"/>

                                    <VBox spacing="6.0">
                                        <Label text="Recipient account" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                        <TextField fx:id="recipientAccountField" promptText="e.g. ACC-10023"
                                                   style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10 14; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-width: 1.2; -fx-border-radius: 8; -fx-font-size: 13.5px; -fx-font-weight: 600;"/>
                                    </VBox>

                                    <VBox spacing="6.0">
                                        <Label text="Amount (LKR)" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                        <TextField fx:id="transferAmountField" promptText="0.00"
                                                   style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10 14; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-width: 1.2; -fx-border-radius: 8; -fx-font-size: 13.5px; -fx-font-weight: 600;"/>
                                    </VBox>

                                    <VBox spacing="6.0">
                                        <Label text="Note (optional)" style="-fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                        <TextField fx:id="referenceNoteField" promptText="What is it for?"
                                                   style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10 14; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-width: 1.2; -fx-border-radius: 8; -fx-font-size: 13.5px;"/>
                                    </VBox>

                                    <Button text="Send money" onAction="#handleFundTransfer" maxWidth="Infinity"
                                            style="-fx-background-color: #fc831bf2; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 22; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(252, 131, 27, 0.42), 8, 0, 0, 2);"/>

                                    <HBox alignment="CENTER_LEFT" style="-fx-padding: 4 0 0 0;">
                                        <Label fx:id="transferStatusLabel" text="" visible="false"
                                               wrapText="true" maxWidth="Infinity"
                                               style="-fx-background-color: #dcfce7; -fx-text-fill: #15803d; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 14; -fx-background-radius: 8;"/>
                                    </HBox>
                                </VBox>

                                <!-- Right Card: HOW YOUR TRANSFER IS PROTECTED -->
                                <VBox prefWidth="560.0" minWidth="460.0" spacing="22.0"
                                      style="-fx-background-color: #ffffff; -fx-padding: 26 28; -fx-background-radius: 18; -fx-border-color: #e2e8f0; -fx-border-width: 1.2; -fx-border-radius: 18; -fx-effect: dropshadow(three-pass-box, rgba(15, 23, 42, 0.04), 14, 0, 0, 4);">
                                    
                                    <Label text="HOW YOUR TRANSFER IS PROTECTED"
                                           style="-fx-text-fill: #64748b; -fx-font-size: 11.5px; -fx-font-weight: 800; -fx-letter-spacing: 0.5px;"/>

                                    <!-- Step 1 -->
                                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                                        <StackPane minWidth="26.0" minHeight="26.0" maxWidth="26.0" maxHeight="26.0"
                                                   style="-fx-background-color: #2563eb; -fx-background-radius: 13;">
                                            <Label text="1" style="-fx-text-fill: white; -fx-font-size: 11.5px; -fx-font-weight: 800;"/>
                                        </StackPane>
                                        <Label text="Request sent over TCP to the bank server"
                                               style="-fx-text-fill: #1e293b; -fx-font-size: 13.5px; -fx-font-weight: 600;"/>
                                    </HBox>

                                    <!-- Step 2 -->
                                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                                        <StackPane minWidth="26.0" minHeight="26.0" maxWidth="26.0" maxHeight="26.0"
                                                   style="-fx-background-color: #2563eb; -fx-background-radius: 13;">
                                            <Label text="2" style="-fx-text-fill: white; -fx-font-size: 11.5px; -fx-font-weight: 800;"/>
                                        </StackPane>
                                        <Label text="Balance and recipient are verified"
                                               style="-fx-text-fill: #1e293b; -fx-font-size: 13.5px; -fx-font-weight: 600;"/>
                                    </HBox>

                                    <!-- Step 3 -->
                                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                                        <StackPane minWidth="26.0" minHeight="26.0" maxWidth="26.0" maxHeight="26.0"
                                                   style="-fx-background-color: #ea580c; -fx-background-radius: 13;">
                                            <Label text="3" style="-fx-text-fill: white; -fx-font-size: 11.5px; -fx-font-weight: 800;"/>
                                        </StackPane>
                                        <Label text="Fraud engine scores the transaction in real time"
                                               style="-fx-text-fill: #1e293b; -fx-font-size: 13.5px; -fx-font-weight: 600;"/>
                                    </HBox>

                                    <!-- Step 4 -->
                                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                                        <StackPane minWidth="26.0" minHeight="26.0" maxWidth="26.0" maxHeight="26.0"
                                                   style="-fx-background-color: #2563eb; -fx-background-radius: 13;">
                                            <Label text="4" style="-fx-text-fill: white; -fx-font-size: 11.5px; -fx-font-weight: 800;"/>
                                        </StackPane>
                                        <Label text="Approved, or held and alert is pushed over UDP"
                                               style="-fx-text-fill: #1e293b; -fx-font-size: 13.5px; -fx-font-weight: 600;"/>
                                    </HBox>

                                </VBox>

                            </HBox>

                        </VBox>
                    </ScrollPane>
                </Tab>

                <!-- ================= TAB 3: FRAUD ALERTS (UDP LIVE - IMAGE 2) ================= -->
                <Tab fx:id="alertsTab" text="Fraud Alerts (UDP Live)">
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                style="-fx-background-color: #f8fafc; -fx-background: #f8fafc;">
                        <VBox spacing="20.0" style="-fx-padding: 24 35 35 35; -fx-background-color: #f8fafc;">
                            
                            <!-- Header Row with LIVE Pill Badge & Back to Home Button -->
                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                                <VBox spacing="3.0">
                                    <Label text="Fraud alerts"
                                           style="-fx-text-fill: #0f172a; -fx-font-size: 28px; -fx-font-weight: 800; -fx-font-family: 'Poppins', 'Urbanist', 'Plus Jakarta Sans', sans-serif;"/>
                                    <Label text="Live feed from UDP Sentinel · Port 6000"
                                           style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <HBox alignment="CENTER" spacing="7.0"
                                      style="-fx-background-color: #dcfce7; -fx-padding: 5 14; -fx-background-radius: 16;">
                                    <Circle radius="3.5" fill="#16a34a"/>
                                    <Label text="LIVE" style="-fx-text-fill: #16a34a; -fx-font-size: 11.5px; -fx-font-weight: 800;"/>
                                </HBox>
                                <Button text="← Back to Home" onAction="#handleBackToHome"
                                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 20; -fx-border-color: #cbd5e1; -fx-border-radius: 20; -fx-cursor: hand;"/>
                            </HBox>

                            <!-- Live Alerts Feed ListView with Custom Floating Cards -->
                            <ListView fx:id="fraudAlertsListView" prefHeight="550.0" minHeight="450.0"
                                      styleClass="alerts-list"/>

                        </VBox>
                    </ScrollPane>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
