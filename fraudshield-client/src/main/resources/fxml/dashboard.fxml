<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="720.0" prefWidth="1000.0" styleClass="root-container" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.fraudshield.client.ui.DashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #1e293b; -fx-padding: 15px 25px; -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 0 0 1 0;">
            <Label style="-fx-text-fill: #f8fafc; -fx-font-size: 18px; -fx-font-weight: bold;" text="FraudShield Banking" />
            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="8.0" styleClass="status-badge">
                <Circle fx:id="statusDot" fill="#22c55e" radius="5.0" />
                <Label fx:id="serverStatusLabel" styleClass="status-text" text="Connected: Port 5000" />
            </HBox>

            <Label fx:id="welcomeUserLabel" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13px;" text="User: ACC-88910" />
            <Button fx:id="logoutButton" onAction="#handleLogout" style="-fx-background-color: #334155; -fx-text-fill: #f8fafc; -fx-background-radius: 6px; -fx-cursor: hand;" text="Logout" />
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-background-color: #0f172a;">
            <Tab text="Account Overview">
                <VBox spacing="20.0" style="-fx-padding: 25px;">
                    <HBox spacing="20.0">
                        <VBox prefWidth="320.0" spacing="10.0" styleClass="login-card" style="-fx-padding: 20px;">
                            <Label styleClass="brand-subtitle" text="AVAILABLE BALANCE" />
                            <Label fx:id="balanceLabel" style="-fx-text-fill: #38bdf8; -fx-font-size: 28px; -fx-font-weight: bold;" text="LKR 150,000.00" />
                            <Label fx:id="accountNumberLabel" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="Account No: 1000-2938-4412" />
                        </VBox>

                        <VBox prefWidth="320.0" spacing="10.0" styleClass="login-card" style="-fx-padding: 20px;">
                            <Label styleClass="brand-subtitle" text="FRAUD SHIELD ENGINE" />
                            <Label style="-fx-text-fill: #4ade80; -fx-font-size: 22px; -fx-font-weight: bold;" text="Active &amp; Protected" />
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="UDP Sentinel listening on Port 6000" />
                        </VBox>
                    </HBox>

                    <Label styleClass="input-label" text="RECENT TRANSACTIONS" />
                    <TableView fx:id="recentTransactionsTable" prefHeight="350.0" VBox.vgrow="ALWAYS" />
                </VBox>
            </Tab>

            <Tab text="Fund Transfer">
                <VBox alignment="TOP_CENTER" style="-fx-padding: 30px;">
                    <VBox maxWidth="450.0" spacing="16.0" styleClass="login-card" style="-fx-padding: 30px;">
                        <Label styleClass="brand-title" style="-fx-font-size: 20px;" text="Instant Fund Transfer" />

                        <VBox spacing="6.0">
                            <Label styleClass="input-label" text="DESTINATION ACCOUNT" />
                            <TextField fx:id="destAccountField" promptText="e.g. 1000-9921-3310" styleClass="text-input-field" />
                        </VBox>

                        <VBox spacing="6.0">
                            <Label styleClass="input-label" text="AMOUNT (LKR)" />
                            <TextField fx:id="transferAmountField" promptText="0.00" styleClass="text-input-field" />
                        </VBox>

                        <VBox spacing="6.0">
                            <Label styleClass="input-label" text="TRANSFER NOTE" />
                            <TextField fx:id="transferNoteField" promptText="e.g. Grocery purchase" styleClass="text-input-field" />
                        </VBox>

                        <Button fx:id="sendTransferButton" maxWidth="Infinity" onAction="#handleTransfer" prefHeight="42.0" styleClass="btn-primary" text="Execute Transfer" />
                        <Label fx:id="transferFeedbackLabel" wrapText="true" visible="false" />
                    </VBox>
                </VBox>
            </Tab>

            <Tab text="Fraud Alerts (UDP Live)">
                <VBox spacing="15.0" style="-fx-padding: 25px;">
                    <Label styleClass="input-label" text="REAL-TIME INCOMING FRAUD ALERTS" />
                    <ListView fx:id="alertsListView" prefHeight="450.0" style="-fx-background-color: #1e293b; -fx-background-radius: 8px;" />
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>