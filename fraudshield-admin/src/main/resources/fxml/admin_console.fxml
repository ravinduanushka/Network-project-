<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lk.fraudshield.admin.ui.AdminController"
            stylesheets="@../styles/admin.css" prefHeight="720.0" prefWidth="1180.0">

    <top>
        <VBox styleClass="header-bar" spacing="10">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="FraudShield Security Operations Console" styleClass="title-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" text="Listening on UDP 6001" styleClass="status-pill"/>
            </HBox>

            <HBox spacing="20">
                <VBox styleClass="metric-card">
                    <Label text="TOTAL ALERTS" styleClass="metric-title"/>
                    <Label fx:id="totalAlertsLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card, metric-held">
                    <Label text="HELD TRANSACTIONS" styleClass="metric-title"/>
                    <Label fx:id="heldCountLabel" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox styleClass="metric-card, metric-blocked">
                    <Label text="AUTO-BLOCKED" styleClass="metric-title"/>
                    <Label fx:id="blockedCountLabel" text="0" styleClass="metric-value"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>

            <!-- Real-time Interactive Charts Section -->
            <HBox spacing="15" prefHeight="240.0" minHeight="240.0">
                <!-- Pie Chart: Risk Decisions Breakdown -->
                <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="480.0">
                    <Label text="Live Risk Decisions Distribution" styleClass="chart-card-title"/>
                    <PieChart fx:id="decisionPieChart" legendVisible="true" animated="true" VBox.vgrow="ALWAYS"/>
                </VBox>

                <!-- Bar Chart: Live Anomaly Scores of Flagged Transactions -->
                <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" prefWidth="600.0">
                    <Label text="Recent Anomaly Risk Scores (0-100)" styleClass="chart-card-title"/>
                    <BarChart fx:id="scoreBarChart" animated="true" legendVisible="false" VBox.vgrow="ALWAYS">
                        <xAxis>
                            <CategoryAxis fx:id="barXAxis" label="Transaction ID" tickLabelFill="#94a3b8"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="barYAxis" label="Risk Score" autoRanging="false" lowerBound="0" upperBound="100" tickUnit="20" tickLabelFill="#94a3b8"/>
                        </yAxis>
                    </BarChart>
                </VBox>
            </HBox>

            <!-- Table View Section -->
            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Label text="Real-Time Flagged &amp; Suspicious Transactions (UDP Live Stream)" styleClass="section-title"/>

                <TableView fx:id="alertsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTxId" text="Tx ID" prefWidth="140"/>
                        <TableColumn fx:id="colAccount" text="Account" prefWidth="120"/>
                        <TableColumn fx:id="colScore" text="Score" prefWidth="80"/>
                        <TableColumn fx:id="colDecision" text="Decision" prefWidth="100"/>
                        <TableColumn fx:id="colReasons" text="Triggered Fraud Rules" prefWidth="420"/>
                        <TableColumn fx:id="colTime" text="Timestamp" prefWidth="160"/>
                    </columns>
                </TableView>

                <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 6 0 0 0;">
                    <Button text="Approve Transaction" onAction="#handleApprove" styleClass="btn-approve"/>
                    <Button text="Block &amp; Freeze Account" onAction="#handleBlock" styleClass="btn-block"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
